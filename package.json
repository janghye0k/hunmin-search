{
  "name": "hunmin-search",
  "version": "0.2.0",
  "private": false,
  "description": "Korean search-as-you-type: IME composing and choseong matching. Zero runtime dependencies.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "^22.0.0 || ^24.0.0 || >=26.0.0"
  },
  "keywords": [
    "hangul",
    "hunmin",
    "korean",
    "search",
    "autocomplete",
    "choseong",
    "subsequence"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janghye0k/hunmin-search.git"
  },
  "bugs": {
    "url": "https://github.com/janghye0k/hunmin-search/issues"
  },
  "homepage": "https://github.com/janghye0k/hunmin-search#readme",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "import": "./dist/browser.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --ignoreConfig --noEmit --strict --skipLibCheck --module esnext --moduleResolution bundler --target es2022 --types node test/search.test.ts",
    "build": "tsdown",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:browser": "playwright test",
    "bench": "vitest bench --run",
    "publish:check": "pnpm run typecheck && pnpm run build && pnpm test",
    "publish:dry-run": "pnpm publish --dry-run --no-git-checks --access public",
    "prepublish:safe": "pnpm run typecheck && pnpm run build && pnpm exec vitest run --exclude test/package-gates.test.ts",
    "prepublishOnly": "pnpm run prepublish:safe",
    "release": "commit-and-tag-version",
    "release:minor": "commit-and-tag-version --release-as minor",
    "release:major": "commit-and-tag-version --release-as major",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^5.1.1",
    "acorn": "^8.16.0",
    "commit-and-tag-version": "^13.4.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.11.0",
    "prettier": "^3.10.1",
    "publint": "^0.3.25",
    "tsdown": "0.23.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1"
  },
  "types": "./dist/index.d.cts"
}
